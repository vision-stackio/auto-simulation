LLM_PROVIDER=openai
LLM_API_KEY=sk-or-v1-your-openrouter-key
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=openrouter/free

# Optional: full path to yt-dlp if not on PATH
# Windows example: YT_DLP_PATH=C:\yt-dlp\yt-dlp.exe
# Linux/macOS example: YT_DLP_PATH=/usr/local/bin/yt-dlp
# YT_DLP_PATH=

# Optional: folder that contains ffmpeg (not the ffmpeg.exe itself)
# Windows example: FFMPEG_PATH=C:\ffmpeg\bin
# FFMPEG_PATH=
