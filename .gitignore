# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build output ───────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ── Environment / Secrets ──────────────────────────────────────
.env
.env.local
.env.*.local
# Keep .env.example tracked — it documents required keys without real values
!.env.example

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Runtime / Temp files ──────────────────────────────────────
*.tmp
*.temp
tmp/
temp/

# ── OS files ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── Editor & IDE ──────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ── Testing ───────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Package manager locks (keep one, ignore others) ───────────
# bun.lock is tracked; ignore yarn/pnpm lockfiles if not used
yarn.lock
pnpm-lock.yaml
